# --- Base de datos local (SQLite) ---
DATABASE_URL="file:./dev.db"

# --- Google Maps (opcional) -------------------------------------------------
# Clave de Outscraper (https://outscraper.com). Es la integración que permite
# consultar Google Maps (nombre, dirección, teléfono, web, rating y número de
# reseñas) para enumerar negocios.
#
# Sin esta clave el flujo funciona EXACTAMENTE igual que antes: la búsqueda web
# y el BORME siguen funcionando y sólo se desactiva la parte de Maps, que es
# opt-in tanto en el Finder como en el barrido diario.
#
# Placeholder: no es una clave válida, la integración se considera no
# configurada mientras deje el valor tal cual.
OUTSCRAPER_API_KEY=tu-clave-aqui

# Mínimo de reseñas para aceptar un negocio de Maps (0 = sin filtro).
# Sirve como filtro de demanda: un negocio con 80 reseñas tiene clientes que
# todavía no tienen agenda online.
OUTSCRAPER_MIN_REVIEWS=0
