    "test:providers": "tsx scripts/test-providers.ts",
    "test:messages": "tsx scripts/test-messages.ts",
    "test:crawl": "tsx scripts/test-crawl.ts",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "cleanup": "tsx scripts/cleanup-leads.ts",
    "setup": "prisma db push && tsx scripts/seed.ts",
    "test:sources": "tsx scripts/test-sources.ts",
    "test:resolve": "tsx scripts/test-resolve.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cheerio": "^1.2.0",
    "iconv-lite": "^0.7.3",
    "next": "15.5.28",
    "nodemailer": "^10.2.1",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
